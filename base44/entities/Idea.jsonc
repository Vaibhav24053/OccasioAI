{
  "name": "Idea",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "\u20b9",
        "\u20b9\u20b9",
        "\u20b9\u20b9\u20b9"
      ],
      "default": "\u20b9\u20b9"
    },
    "estimated_cost": {
      "type": "number"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decor_ideas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "music_mood": {
      "type": "string"
    },
    "food_stations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "culture_notes": {
      "type": "string"
    },
    "saved": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "event_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}