{
  "name": "RunSheet",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "schedule",
        "contingency"
      ],
      "default": "schedule"
    },
    "start_time": {
      "type": "string",
      "description": "24h clock, e.g. 16:30"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "activity": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "For contingency items: rain plan, first aid, backup contact"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "event_id",
    "activity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}