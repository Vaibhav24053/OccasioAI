{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "category_label": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "quoted_price": {
      "type": "number"
    },
    "budget_allocated": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "researching",
        "contacted",
        "booked",
        "paid"
      ],
      "default": "researching"
    },
    "why": {
      "type": "string",
      "description": "AI note on why this vendor category matters"
    },
    "notes": {
      "type": "string"
    },
    "outreach_draft": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "event_id",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}